# Optional settings. No credentials or env file are needed.
# Sign in to the official Secureframe MCP through Claude Code on macOS.
# All authenticated calls reuse that cached OAuth sign-in.

SECUREFRAME_MCP_MODE=supplemental

# Optional selection when multiple cached Secureframe sign-ins exist:
# SECUREFRAME_CLAUDE_SERVER_NAME=secureframe
# Normally inferred from the single matching OAuth sign-in; UK example:
# SECUREFRAME_API_URL=https://api-uk.secureframe.com

# Optional custom Claude profile / Keychain service:
# CLAUDE_CONFIG_DIR=/absolute/path/to/claude-profile
# SECUREFRAME_CLAUDE_KEYCHAIN_SERVICE=Claude Code-credentials

SECUREFRAME_READ_ONLY=false

# Optional settings file, loaded at startup. No credentials belong in it.
# SECUREFRAME_ENV_FILE=/absolute/path/to/secureframe-settings.env

# Supplemental mode supports stdio only. Legacy mode also supports HTTP.
SECUREFRAME_MCP_TRANSPORT=stdio
SECUREFRAME_MCP_HOST=127.0.0.1
SECUREFRAME_MCP_PORT=8000

# Filter exposed tools by tags; exclude wins over include.
# SECUREFRAME_EXCLUDE_TAGS=write
# SECUREFRAME_TOOL_TAGS=uploads
SECUREFRAME_TOOL_TAGS=
SECUREFRAME_EXCLUDE_TAGS=
